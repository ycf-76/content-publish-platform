{"id": "text-translator", "version": "1.0.0", "name": "AI Text Translator", "description": "基于大语言模型的多语言翻译节点，支持100+种语言互译，自动检测源语言，提供多种翻译风格", "author": {"name": "Platform Team", "email": "dev@your-platform.com"}, "category": "workflow_node", "entry_point": "main.py:TextTranslatorPlugin", "display_icon": "🌐", "tags": ["ai", "translation", "nlp", "multilingual", "llm"], "capabilities": ["execute", "validate_inputs", "optimize_output"], "permissions_required": ["llm:use", "network:read"], "config_schema": {"type": "object", "properties": {"api_provider": {"type": "string", "title": "API提供商", "enum": ["openai", "deepseek", "anthropic", "mock"], "default": "openai", "description": "选择LLM API服务提供商"}, "model_name": {"type": "string", "title": "模型名称", "default": "gpt-3.5-turbo", "description": "要使用的具体模型（根据provider不同而不同）", "examples": ["gpt-4", "gpt-3.5-turbo", "deepseek-chat", "claude-3"]}, "api_key": {"type": "string", "title": "API密钥", "format": "password", "description": "API访问密钥（加密存储）"}, "base_url": {"type": "string", "title": "API端点URL", "format": "uri", "default": "", "description": "自定义API端点（留空使用默认值）"}, "temperature": {"type": "number", "title": "生成温度", "minimum": 0, "maximum": 2, "default": 0.3, "description": "值越低输出越确定，越高越随机（翻译建议用低值）"}, "max_tokens": {"type": "integer", "title": "最大生成长度", "minimum": 100, "maximum": 8000, "default": 2000, "description": "限制生成的token数量"}, "translation_style": {"type": "string", "title": "翻译风格", "enum": ["literal", "natural", "formal", "casual", "academic"], "default": "natural", "description": "选择翻译的风格和语气"}, "preserve_formatting": {"type": "boolean", "title": "保留格式", "default": true, "description": "是否保留原文的格式标记（如Markdown、HTML等）"}, "enable_cache": {"type": "boolean", "title": "启用缓存", "default": true, "description": "缓存相同文本的翻译结果以节省费用"}, "cache_ttl_hours": {"type": "integer", "title": "缓存有效期（小时）", "minimum": 1, "maximum": 168, "default": 24}, "batch_size": {"type": "integer", "title": "批量处理大小", "minimum": 1, "maximum": 50, "default": 10, "description": "一次最多处理的文本数量"}}, "required": ["api_key"], "x-ui": {"group_by_category": true}}, "input_schema": {"type": "object", "properties": {"texts": {"oneOf": [{"type": "string", "description": "单个待翻译文本"}, {"type": "array", "items": {"type": "string"}, "description": "多个待翻译文本（批量模式）"}], "title": "待翻译文本"}, "target_language": {"type": "string", "title": "目标语言", "enum": ["zh", "en", "ja", "ko", "fr", "de", "es", "it", "pt", "ru", "ar", "hi", "auto"], "default": "en", "description": "翻译成的目标语言代码"}, "source_language": {"type": "string", "title": "源语言（可选）", "enum": ["zh", "en", "ja", "ko", "fr", "de", "es", "auto"], "default": "auto", "description": "留空则自动检测源语言"}, "context": {"type": "string", "title": "上下文提示", "description": "额外的上下文信息帮助提高翻译质量（可选）"}}, "required": ["texts", "target_language"]}, "output_schema": {"type": "object", "properties": {"translations": {"type": "array", "items": {"type": "object", "properties": {"original": {"type": "string"}, "translated": {"type": "string"}, "source_lang": {"type": "string"}, "target_lang": {"type": "string"}, "confidence": {"type": "number"}, "token_count": {"type": "integer"}}}, "description": "翻译结果列表"}, "summary": {"type": "object", "properties": {"total_texts": {"type": "integer"}, "total_tokens_used": {"type": "number"}, "estimated_cost_usd": {"type": "number"}, "processing_time_ms": {"type": "number"}, "cache_hits": {"type": "integer"}}}}}, "pricing_model": "freemium", "min_platform_version": "1.0.0", "dependencies": [], "events_subscribes": [], "events_emits": ["translation:started", "translation:completed", "translation:failed", "translation:cache_hit"]}