{"id": "weibo-publisher", "version": "1.0.0", "name": "Weibo Publisher", "description": "微博发布平台插件 - 支持图文、视频内容发布到微博，包含OAuth2认证、定时发布、发布历史管理和多账号支持", "author": {"name": "Platform Team", "email": "dev@your-platform.com"}, "category": "platform", "entry_point": "main.py:WeiboPublisherPlugin", "display_icon": "📱", "tags": ["weibo", "social-media", "publishing", "chinese", "platform"], "capabilities": ["execute", "validate_inputs", "schedule_publish", "manage_accounts"], "permissions_required": ["network:read_write", "storage:read_write", "auth:oauth"], "config_schema": {"type": "object", "properties": {"app_key": {"type": "string", "title": "微博App Key", "format": "password", "description": "微博开放平台应用Key"}, "app_secret": {"type": "string", "title": "微博App Secret", "format": "password", "description": "微博开放平台应用密钥"}, "redirect_uri": {"type": "string", "title": "回调地址", "format": "uri", "default": "https://your-platform.com/callback/weibo"}, "default_account_id": {"type": "string", "title": "默认账号ID", "description": "默认使用的微博账号"}, "max_text_length": {"type": "integer", "title": "最大文字长度", "default": 280, "minimum": 140, "maximum": 2000}, "enable_image_compression": {"type": "boolean", "title": "启用图片压缩", "default": true}, "image_quality": {"type": "integer", "title": "图片质量(%)", "default": 85, "minimum": 50, "maximum": 100}, "auto_retry_on_failure": {"type": "boolean", "title": "失败自动重试", "default": true}, "retry_count": {"type": "integer", "title": "重试次数", "default": 3, "minimum": 0, "maximum": 10}, "rate_limit_per_hour": {"type": "integer", "title": "每小时发布上限", "default": 30, "minimum": 5, "maximum": 100}}, "required": ["app_key", "app_secret"], "x-ui": {"group_by_category": true}}, "input_schema": {"type": "object", "properties": {"action": {"type": "string", "enum": ["publish_text", "publish_image", "publish_video", "schedule_publish", "get_publish_history", "delete_post", "get_account_info"], "default": "publish_text", "title": "操作类型"}, "content": {"type": "object", "properties": {"text": {"type": "string", "maxLength": 2000, "title": "正文内容"}, "images": {"type": "array", "items": {"type": "string", "format": "uri"}, "title": "图片URL列表（最多9张）"}, "video_url": {"type": "string", "format": "uri", "title": "视频URL"}, "topics": {"type": "array", "items": {"type": "string"}, "title": "话题标签"}, "visibility": {"type": "string", "enum": ["public", "friends", "private"], "default": "public", "title": "可见范围"}, "location": {"type": "object", "properties": {"latitude": {"type": "number"}, "longitude": {"type": "number"}, "name": {"type": "string"}}, "title": "地理位置"}}, "required": ["text"]}, "account_id": {"type": "string", "title": "账号ID（可选）"}, "scheduled_time": {"type": "string", "format": "date-time", "title": "定时发布时间"}, "post_id": {"type": "string", "title": "微博ID（删除操作用）"}}, "required": ["action", "content"]}, "output_schema": {"type": "object", "properties": {"success": {"type": "boolean"}, "post_id": {"type": "string"}, "post_url": {"type": "string", "format": "uri"}, "published_at": {"type": "string", "format": "date-time"}, "stats": {"type": "object", "properties": {"text_length": {"type": "integer"}, "image_count": {"type": "integer"}, "has_video": {"type": "boolean"}}}}}, "pricing_model": "freemium", "min_platform_version": "1.0.0", "dependencies": ["requests>=2.31.0", "Pillow>=10.0.0"], "events_subscribes": [], "events_emits": ["weibo:publish_success", "weibo:publish_failed", "weibo:scheduled", "weibo:deleted"]}