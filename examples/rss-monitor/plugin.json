{"id": "rss-monitor", "version": "1.0.0", "name": "RSS Monitor", "description": "RSS订阅源监控插件 - 定时抓取RSS/Atom feed，检测新内容并推送事件通知，支持内容过滤和去重", "author": {"name": "Platform Team", "email": "dev@your-platform.com"}, "category": "datasource", "entry_point": "main.py:RSSMonitorPlugin", "display_icon": "📡", "tags": ["rss", "monitor", "feed", "news", "content", "datasource"], "capabilities": ["execute", "poll", "validate_config"], "permissions_required": ["network:read", "storage:read_write"], "config_schema": {"type": "object", "properties": {"feed_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "title": "RSS Feed URLs", "description": "要监控的RSS/Atom feed地址列表", "minItems": 1, "maxItems": 50, "examples": ["https://feeds.bbci.co.uk/news/technology/rss.xml", "https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml"]}, "poll_interval_minutes": {"type": "integer", "title": "轮询间隔（分钟）", "description": "检查新内容的频率", "minimum": 5, "maximum": 1440, "default": 30}, "max_items_per_feed": {"type": "integer", "title": "每个Feed最大条目数", "description": "每次轮询从每个feed获取的最大条目数", "minimum": 1, "maximum": 100, "default": 20}, "enable_content_filter": {"type": "boolean", "title": "启用内容过滤", "default": true, "description": "是否根据关键词过滤内容"}, "filter_keywords": {"type": "object", "properties": {"include": {"type": "array", "items": {"type": "string"}, "description": "包含的关键词（任一匹配即保留）"}, "exclude": {"type": "array", "items": {"type": "string"}, "description": "排除的关键词（任一匹配即丢弃）"}}, "title": "过滤关键词"}, "dedup_enabled": {"type": "boolean", "title": "启用去重", "default": true, "description": "是否基于标题或URL去重"}, "dedup_window_hours": {"type": "integer", "title": "去重时间窗口（小时）", "default": 168, "minimum": 1, "maximum": 720}, "notify_on_new_items": {"type": "boolean", "title": "新内容通知", "default": true, "description": "发现新内容时是否发送事件通知"}, "timeout_seconds": {"type": "integer", "title": "请求超时时间（秒）", "default": 30, "minimum": 5, "maximum": 120}}, "required": ["feed_urls"], "x-ui": {"group_by_category": true}}, "input_schema": {"type": "object", "properties": {"action": {"type": "string", "enum": ["poll_now", "list_feeds", "get_stats", "clear_cache"], "default": "poll_now", "title": "操作类型"}, "feed_url": {"type": "string", "description": "指定操作的Feed URL（可选）", "format": "uri"}, "since_timestamp": {"type": "string", "format": "date-time", "description": "只获取此时间之后的内容"}}, "required": ["action"]}, "output_schema": {"type": "object", "properties": {"items": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "summary": {"type": "string"}, "published_at": {"type": "string", "format": "date-time"}, "author": {"type": "string"}, "feed_url": {"type": "string"}, "categories": {"type": "array", "items": {"type": "string"}}}}}, "summary": {"type": "object", "properties": {"total_feeds": {"type": "integer"}, "total_items": {"type": "integer"}, "new_items": {"type": "integer"}, "processing_time_ms": {"type": "integer"}, "errors": {"type": "array", "items": {"type": "object"}}}}}}, "pricing_model": "free", "min_platform_version": "1.0.0", "dependencies": ["feedparser>=6.0.0", "httpx>=0.24.0"], "events_subscribes": [], "events_emits": ["rss:new_item_found", "rss:poll_completed", "rss:error_occurred"]}