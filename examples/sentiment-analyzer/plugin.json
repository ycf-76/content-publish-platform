{"id": "sentiment-analyzer", "version": "1.0.0", "name": "AI Sentiment Analyzer", "description": "基于大语言模型的情感分析与文本理解节点，支持多维度情感识别、情感强度评分、关键词提取和可视化报告生成", "author": {"name": "Platform Team", "email": "dev@your-platform.com"}, "category": "workflow_node", "entry_point": "main.py:SentimentAnalyzerPlugin", "display_icon": "📊", "tags": ["ai", "nlp", "sentiment-analysis", "text-mining", "visualization"], "capabilities": ["execute", "validate_inputs", "generate_report"], "permissions_required": ["llm:use", "network:read"], "config_schema": {"type": "object", "properties": {"api_provider": {"type": "string", "title": "API提供商", "enum": ["openai", "deepseek", "anthropic", "local_model"], "default": "openai"}, "model_name": {"type": "string", "title": "模型名称", "default": "gpt-4", "description": "推荐使用更强的模型以获得更好的分析质量"}, "api_key": {"type": "string", "title": "API密钥", "format": "password"}, "base_url": {"type": "string", "title": "自定义端点URL", "format": "uri"}, "temperature": {"type": "number", "title": "温度参数", "minimum": 0, "maximum": 1, "default": 0.1, "description": "低值确保输出更确定和分析一致"}, "max_tokens": {"type": "integer", "title": "最大生成长度", "minimum": 500, "maximum": 8000, "default": 3000}, "analysis_dimensions": {"type": "array", "items": {"type": "string", "enum": ["emotion", "sentiment", "subjectivity", "polarity", "intensity", "aspects"]}, "title": "分析维度", "default": ["sentiment", "emotion", "aspects"], "description": "选择要分析的维度"}, "output_format": {"type": "string", "title": "输出格式", "enum": ["json", "detailed_json", "summary", "report"], "default": "detailed_json", "description": "JSON格式适合程序处理，Report格式包含可视化建议"}, "include_keywords": {"type": "boolean", "title": "提取关键词", "default": true}, "include_entities": {"type": "boolean", "title": "实体识别", "default": false}, "language_detection": {"type": "boolean", "title": "自动语言检测", "default": true}, "batch_size": {"type": "integer", "title": "批量大小", "minimum": 1, "maximum": 20, "default": 5}}, "required": ["api_key"]}, "input_schema": {"type": "object", "properties": {"texts": {"oneOf": [{"type": "string", "description": "单个待分析文本"}, {"type": "array", "items": {"type": "string"}}], "title": "待分析文本"}, "context": {"type": "string", "title": "领域上下文", "description": "帮助模型理解的背景信息（如：产品评论、社交媒体、新闻等）"}, "custom_labels": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}, "title": "自定义标签映射", "description": "将情感映射到自定义业务标签"}}, "required": ["texts"]}, "output_schema": {"type": "object", "properties": {"analyses": {"type": "array", "items": {"type": "object"}}, "summary": {"type": "object", "properties": {"total_texts": {"type": "integer"}, "avg_sentiment_score": {"type": "number"}, "sentiment_distribution": {"type": "object"}, "top_emotions": {"type": "array"}, "key_findings": {"type": "array"}, "processing_time_ms": {"type": "number"}, "tokens_used": {"type": "number"}, "estimated_cost_usd": {"type": "number"}}}}}, "pricing_model": "freemium", "min_platform_version": "1.0.0", "dependencies": [], "events_subscribes": [], "events_emits": ["analysis:started", "analysis:completed", "analysis:failed"]}