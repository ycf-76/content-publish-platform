{"id": "notification-bot", "version": "1.0.0", "name": "Notification Bot", "description": "多渠道通知集成机器人 - 支持邮件、微信、钉钉、Slack、Webhook等多种通知渠道，包含模板系统、优先级队列、频率限制和发送状态追踪", "author": {"name": "Platform Team", "email": "dev@your-platform.com"}, "category": "integration", "entry_point": "main.py:NotificationBotPlugin", "display_icon": "🔔", "tags": ["notification", "alert", "multi-channel", "email", "wechat", "dingtalk", "slack", "webhook"], "capabilities": ["execute", "send_notification", "manage_templates", "track_delivery"], "permissions_required": ["network:read_write", "storage:read_write", "notification:send"], "config_schema": {"type": "object", "properties": {"channels": {"type": "array", "items": {"type": "object", "properties": {"channel_type": {"type": "string", "enum": ["email", "wechat", "dingtalk", "slack", "webhook", "sms"], "title": "渠道类型"}, "enabled": {"type": "boolean", "default": true, "title": "是否启用"}, "config": {"type": "object", "title": "渠道配置"}, "priority": {"type": "integer", "minimum": 1, "maximum": 10, "default": 5, "title": "优先级"}}, "required": ["channel_type"]}, "title": "通知渠道配置"}, "default_template_id": {"type": "string", "title": "默认模板ID", "description": "未指定模板时使用的默认模板"}, "rate_limit_per_minute": {"type": "integer", "title": "每分钟最大发送数", "default": 10, "minimum": 1, "maximum": 100}, "enable_deduplication": {"type": "boolean", "title": "启用去重", "default": true}, "dedup_window_seconds": {"type": "integer", "title": "去重时间窗口（秒）", "default": 300, "minimum": 60, "maximum": 3600}, "retry_failed_notifications": {"type": "boolean", "title": "失败自动重试", "default": true}, "max_retries": {"type": "integer", "title": "最大重试次数", "default": 3, "minimum": 0, "maximum": 10}, "store_history_days": {"type": "integer", "title": "历史记录保留天数", "default": 7, "minimum": 1, "maximum": 90}}, "required": ["channels"], "x-ui": {"group_by_category": true}}, "input_schema": {"type": "object", "properties": {"action": {"type": "string", "enum": ["send", "batch_send", "get_status", "get_templates", "create_template", "delete_template", "get_statistics", "retry_failed"], "default": "send", "title": "操作类型"}, "notification": {"type": "object", "properties": {"title": {"type": "string", "maxLength": 200, "title": "通知标题"}, "content": {"type": "string", "maxLength": 5000, "title": "通知内容"}, "priority": {"type": "string", "enum": ["low", "normal", "high", "urgent"], "default": "normal", "title": "优先级"}, "channels": {"type": "array", "items": {"type": "string"}, "title": "目标渠道（留空使用全部）"}, "recipients": {"type": "array", "items": {"type": "string"}, "title": "接收者列表"}, "template_id": {"type": "string", "title": "使用的模板ID"}, "metadata": {"type": "object", "title": "附加元数据"}, "expire_at": {"type": "string", "format": "date-time", "title": "过期时间"}}, "required": ["title", "content"]}, "notifications": {"type": "array", "items": {"$ref": "#/properties/notification"}, "title": "批量通知列表"}, "notification_id": {"type": "string", "title": "通知ID（查询状态用）"}, "template": {"type": "object", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "subject_template": {"type": "string"}, "body_template": {"type": "string"}, "channels": {"type": "array", "items": {"type": "string"}}}}, "limit": {"type": "integer", "title": "返回数量限制"}}, "required": ["action"]}, "output_schema": {"type": "object", "properties": {"success": {"type": "boolean"}, "notification_id": {"type": "string"}, "status": {"type": "string", "enum": ["sent", "pending", "failed", "delivered", "read"]}, "sent_channels": {"type": "array", "items": {"type": "string"}}, "statistics": {"type": "object", "properties": {"total_sent": {"type": "integer"}, "successful": {"type": "integer"}, "failed": {"type": "integer"}, "by_channel": {"type": "object"}}}}}, "pricing_model": "freemium", "min_platform_version": "1.0.0", "dependencies": ["aiohttp>=3.9.0", "jinja2>=3.1.2"], "events_subscribes": [], "events_emits": ["notification:sent", "notification:failed", "notification:delivered", "notification:read"]}