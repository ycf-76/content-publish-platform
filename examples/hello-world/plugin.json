{"id": "hello-world", "version": "1.0.0", "name": "Hello World", "description": "最简单的插件示例 - 生成个性化问候语，适合学习插件开发基础", "author": {"name": "Platform Team", "email": "dev@your-platform.com"}, "category": "workflow_node", "entry_point": "main.py:HelloWorldPlugin", "display_icon": "👋", "tags": ["example", "beginner", "tutorial", "hello-world"], "capabilities": ["execute"], "permissions_required": [], "config_schema": {"type": "object", "properties": {"greeting_template": {"type": "string", "title": "问候语模板", "description": "自定义问候语模板，使用 {name} 作为占位符", "default": "Hello, {name}!", "examples": ["你好, {name}!", "Welcome, {name}!", "Hola, {name}!"]}, "include_timestamp": {"type": "boolean", "title": "包含时间戳", "description": "是否在输出中包含当前时间", "default": true}, "emoji_style": {"type": "string", "title": "表情符号风格", "enum": ["none", "friendly", "party", "professional"], "default": "friendly"}}, "required": []}, "input_schema": {"type": "object", "properties": {"name": {"type": "string", "title": "姓名", "description": "要问候的人的名字", "minLength": 1, "maxLength": 100, "examples": ["World", "Alice", "Plugin Developer"]}}, "required": ["name"]}, "output_schema": {"type": "object", "properties": {"greeting": {"type": "string", "description": "生成的问候语"}, "timestamp": {"type": "string", "format": "date-time", "description": "生成时间（如果启用）"}, "metadata": {"type": "object", "properties": {"plugin_version": {"type": "string"}, "processing_time_ms": {"type": "number"}}}}}, "pricing_model": "free", "min_platform_version": "1.0.0", "dependencies": [], "events_subscribes": [], "events_emits": ["greeting:generated"]}