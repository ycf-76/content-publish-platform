# ============================================================
# 小红书选题池智能监控系统 - 环境变量配置
# ============================================================
# 说明：本模块继承项目全局 Settings，DATABASE_URL / DEEPSEEK_API_KEY
#       等基础配置沿用项目根目录 .env，以下仅为选题池专用配置项。
#       将需要的项追加到 backend/.env 即可生效（不配则用默认值）。
# ============================================================

# ===== 抓取调度 =====
# 抓取间隔（分钟），默认 10
CRAWL_INTERVAL_MINUTES=10
# 单次抓取条数上限，默认 10
MAX_FETCH_PER_RUN=10

# ===== 池子水位 =====
# 池子最大容量，默认 200
MAX_POOL_SIZE=200
# 最低水位（低于此值触发紧急补抓），默认 150
POOL_MIN_THRESHOLD=150
# 启动时若低于此值立即触发一次抓取，默认 50
POOL_STARTUP_THRESHOLD=50

# ===== 评分阈值 =====
# 入池热度分阈值（≥此值入池），默认 60
HEAT_SCORE_THRESHOLD=60
# 互动量满分基准（赞数达到此值得满分），默认 5000
SCORE_LIKES_BASELINE=5000

# ===== 去重 =====
# SimHash 汉明距离阈值（≤则视为重复，对应相似度 > 85%），默认 8
SIMHASH_HAMMING_THRESHOLD=8

# ===== 清理 =====
# 每日清理任务执行小时（0-23），默认 2（凌晨2点）
CLEANUP_HOUR=2
# 过期清理阈值（小时），默认 72
CLEANUP_EXPIRE_HOURS=72
# 过期清理的热度分上限（< 此值且超时才删），默认 40
CLEANUP_EXPIRE_SCORE=40

# ===== LLM 智能分类 =====
# 分类用 LLM API Key，留空则自动复用 DEEPSEEK_API_KEY
LLM_API_KEY=
# 分类用模型名
LLM_MODEL=deepseek-chat
# LLM 调用超时（秒）
LLM_TIMEOUT_SECONDS=30

# ===== 随机 UA 池 =====
# USER_AGENT_LIST 为列表类型，默认内置 3 个 UA，一般无需配置；
# 如需自定义，在 .env 中用 JSON 数组字符串配置：
# USER_AGENT_LIST=["UA1","UA2"]
