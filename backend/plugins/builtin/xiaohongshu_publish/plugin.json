{"id": "xiaohongshu-publish", "name": "小红书发布器", "version": "1.0.0", "description": "向小红书平台发布笔记内容，支持图文混排、话题标签、定时发布等功能。采用MCP Client Manager架构，优先使用浏览器扩展（RPA方案）进行无痕发布，失败时自动回退到本地Playwright客户端。", "author": {"name": "Platform Team", "email": "dev@creator-platform.com"}, "category": "platform", "entry_point": "xiaohongshu_publish.py:XiaohongshuPublishPlugin", "display_icon": "📕", "tags": ["publishing", "xiaohongshu", "social-media", "content-distribution"], "capabilities": ["authenticate", "publish", "get_analytics", "delete_content"], "permissions_required": ["xhs:publish", "xhs:read"], "config_schema": {"type": "object", "properties": {"publish_mode": {"type": "string", "enum": ["auto", "semi_auto", "manual"], "default": "semi_auto", "description": "发布模式：全自动/半自动（填好内容等待手动点击）/纯手动"}, "client_preference": {"type": "string", "enum": ["plugin_first", "local_only"], "default": "plugin_first", "description": "客户端选择：优先使用浏览器扩展 / 仅使用本地Playwright"}, "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 300, "default": 60, "description": "发布操作超时时间（秒）"}, "retry_count": {"type": "integer", "minimum": 0, "maximum": 5, "default": 2, "description": "失败重试次数"}}, "required": []}, "pricing_model": "free", "min_platform_version": "1.0.0", "dependencies": [], "events_subscribes": ["workflow:node_completed:*"], "events_emits": ["content:published", "content:publish_failed", "content:awaiting_manual_confirm"]}