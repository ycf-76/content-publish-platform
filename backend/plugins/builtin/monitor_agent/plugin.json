{"id": "monitor-agent", "name": "热点监控智能体", "version": "1.0.0", "description": "全平台热点内容监控系统，定时抓取HackerNews、Reddit、Tavily等平台的热门内容，通过LLM进行三维分类（情绪/场景/视觉），SimHash去重后评分入池，为内容创作提供实时灵感来源。支持自动调度、异常容错和关键词降级分类。", "author": {"name": "AI Agent Team", "email": "agents@creator-platform.com"}, "category": "datasource", "entry_point": "monitor_agent.py:MonitorAgentPlugin", "display_icon": "🔍", "tags": ["monitoring", "trending", "content-discovery", "automation", "ai-classification"], "capabilities": ["search_trending", "get_trending", "classify_content", "deduplicate"], "permissions_required": ["network:read", "llm:use"], "config_schema": {"type": "object", "properties": {"scan_interval_minutes": {"type": "integer", "minimum": 5, "maximum": 60, "default": 10, "description": "扫描间隔时间（分钟）"}, "max_items_per_source": {"type": "integer", "minimum": 5, "maximum": 100, "default": 20, "description": "每个数据源最大获取条数"}, "enable_llm_classification": {"type": "boolean", "default": true, "description": "启用LLM三维分类（关闭则使用关键词匹配降级）"}, "simhash_threshold": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3, "description": "SimHash去重阈值（汉明距离）"}, "min_score_threshold": {"type": "number", "minimum": 0, "maximum": 100, "default": 50, "description": "最低评分阈值（低于此分不入池）"}, "enabled_sources": {"type": "array", "items": {"type": "string"}, "default": ["hackernews", "reddit", "tavily", "builtin"], "description": "启用的数据源列表"}}, "required": []}, "pricing_model": "free", "min_platform_version": "1.0.0", "dependencies": [], "events_subscribes": ["system:scheduler:tick", "config:changed:*"], "events_emits": ["datasource:trending_found", "datasource:item_classified", "datasource:item_scored", "datasource:error"]}