# ===== 应用 =====
APP_NAME=multi-agent-xhs-platform
DEBUG=false
ENVIRONMENT=dev

# ===== 数据库 =====
# dev 默认 SQLite（零依赖启动，单文件）；生产换 mysql+aiomysql:// 或 postgresql+asyncpg://
DATABASE_URL=sqlite+aiosqlite:///./data/xhs_agent.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== LLM: DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_V3=deepseek-chat
DEEPSEEK_MODEL_R1=deepseek-reasoner

# ===== 阿里云百炼 (Qwen-VL + 通义万相) =====
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen-vl-max
WANX_MODEL=wanx-v1
JIMENG_API_KEY=

# ===== 多厂商对话模型（前端模型切换器，按需配置）=====
# 说明：以上 DeepSeek / 百炼 Key 已覆盖 DeepSeek-V3/R1 与 Qwen-VL/Max。
# 以下为可选厂商；不配置对应 Key 时，前端仍可选该模型，
# 但发起对话会返回明确提示（不会再静默回退到 DeepSeek）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# 注：使用 Claude 需额外 pip install anthropic 并重启后端
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL=gemini-1.5-flash
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus
# 通义千问文本（OpenAI 兼容端点，复用 DASHSCOPE_API_KEY）
QWEN_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-max

# ===== 小红书 MCP =====
XHS_MCP_PLUGIN_URL=
XHS_MCP_LOCAL_CMD=
XHS_MCP_MODE=plugin

# ===== 多平台内容源（ContentSource）=====
# 默认数据源平台：tavily / builtin / hackernews / reddit / xiaohongshu
# tavily = Tavily 全网搜索（Google/Bing 级覆盖面，推荐，需 TAVILY_API_KEY）
# builtin = 内置中文话题库（零网络依赖，覆盖穿搭/美妆/美食等小红书常见类目）
# hackernews = HackerNews（技术社区，英文内容）
# reddit = Reddit（需配置下方凭证）
DEFAULT_SOURCE_PLATFORM=tavily
# 是否启用小红书内容源（默认关闭，有风控风险）
XHS_SOURCE_ENABLED=false

# ===== HTTP 代理（访问国外社媒 API）=====
# 所有 ContentSource 的 httpx client 共享此代理
# 格式：http://127.0.0.1:端口（Clash/V2Ray 本地监听地址）
# 设为 system 时自动探测系统代理（HTTP_PROXY/HTTPS_PROXY 环境变量）
# 为空则不走代理（国内 API 如热榜源/头条搜索不受影响）
HTTP_PROXY=

# ===== Tavily API（全网搜索，专为 AI Agent 设计）=====
# 申请地址：https://app.tavily.com/（新用户有免费额度）
# 配置后 search 节点会用 Tavily 做全网搜索（覆盖面比 HackerNews/Reddit 更广）
TAVILY_API_KEY=

# ===== Serper API（Google SERP 数据，Tavily 降级备选）=====
# 申请地址：https://serper.dev/（2,500 次免费，无需信用卡）
# 返回 Google 原始搜索结果，搜 "小红书 + 关键词" 可获取被转载的小红书内容
SERPER_API_KEY=

# ===== YouTube Data API v3 =====
# 申请地址：https://console.cloud.google.com/apis/credentials
# 创建 API Key → 启用 YouTube Data API v3 → 粘贴到下方
# 免费配额：10,000 单位/天（搜索一次 ~100 单位，约 100 次搜索/天）
YOUTUBE_API_KEY=

# ===== Brave Search API（独立索引，差异化搜索）=====
# 申请地址：https://brave.com/search/api/（2,000 次/月免费）
# 独立爬虫索引，不依赖 Google，覆盖 Google 未收录的页面
BRAVE_API_KEY=

# ===== Reddit API（OAuth2 personal use script）=====
# 申请地址：https://www.reddit.com/prefs/apps（选 script 类型）
# 填写后 search 节点会同时搜 HackerNews + Reddit，综合返回
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# script app 模式需要 Reddit 账号密码（用于搜索，client_credentials 模式只能拿热门不能搜索）
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ===== 加密 =====
AES_SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ===== LangGraph / Recovery =====
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_CIRCUIT_FAILURE_THRESHOLD=5
RECOVERY_CIRCUIT_RECOVERY_TIMEOUT=60
STRUCTURAL_RECOVERY_TIMEOUT_SECONDS=1800

# ===== SSE =====
SSE_HEARTBEAT_SECONDS=15
SSE_EVENT_BUFFER_LIMIT=1000

# ===== LangSmith（LangChain 追踪 & 评估平台）=====
# 申请地址：https://smith.langchain.com/（注册后获取 API Key）
# 开启后所有 LangGraph 工作流运行会自动追踪到 LangSmith 控制台
# 可查看每个节点的输入/输出/耗时/Token 用量/错误堆栈
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# 项目名称（在 LangSmith 控制台中分组展示）
LANGCHAIN_PROJECT=multi-agent-xhs-platform
# LangSmith 服务地址（默认官方，自部署时修改）
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ===== Redis =====
# 留空或不配置时自动降级为内存缓存（单进程有效，不支持分布式）
# 安装 Redis 后取消注释：
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_POOL_SIZE=20

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 飞书集成 =====
# 申请地址：https://open.feishu.cn/app（创建自建应用，获取 App ID 和 App Secret）
# 事件订阅：在应用后台→事件订阅中配置，获取 Verification Token 和 Encrypt Key
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 多维表格：在飞书中创建多维表格，从 URL 中提取 App Token 和 Table ID
# URL 格式：https://xxx.feishu.cn/base/<APP_TOKEN>?table=<TABLE_ID>
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# OAuth 回调地址必须与飞书开放平台「安全设置 > 重定向 URL」完全一致
FEISHU_OAUTH_REDIRECT_URI=http://localhost:8000/api/feishu/oauth/callback
FEISHU_OAUTH_FRONTEND_URL=http://localhost:5173
# 用户授权 scope：离线访问 + Wiki/Doc 读写
FEISHU_OAUTH_SCOPES=offline_access wiki:wiki docx:document docs:doc search:docs:read

# ===== SMTP（邮箱验证码发送）=====
# 常见配置：
#   QQ 邮箱：smtp.qq.com / 465 / SSL / 授权码（非 QQ 密码，去 QQ 邮箱设置→账户→POP3/SMTP 开启获取）
#   163 邮箱：smtp.163.com / 465 / SSL / 授权码
#   Gmail：smtp.gmail.com / 587 / TLS / 应用专用密码
#   Outlook：smtp.office365.com / 587 / TLS / 密码
# 不配置时进入开发模式：验证码打印到后端日志，不发真实邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=false

# ===== 通用浏览器自动化（任意网站，非小红书专用）=====
# 域名白名单（逗号分隔，域后缀匹配：填 a.com 即放行 a.com 与 *.a.com）。
# 这是安全边界而非能力限制：任何网站都能用，只是需先加入白名单
# （或运行时调 POST /api/browser/domains 临时放行，TTL 到期自动失效）。
# 例：BROWSER_ALLOWED_DOMAINS=xiaohongshu.com,feishu.cn,example.com,wikipedia.org,baidu.com
BROWSER_ALLOWED_DOMAINS=xiaohongshu.com,feishu.cn,open.feishu.cn
# 智能体浏览器权限（高危，默认拒绝；放开后 chat_agent 才能自主浏览网页）
# PERMISSIONS_ALLOW=browser:automate
# 对外 MCP Server（/api/mcp/browser）的 Bearer token；留空则启动时自动生成并打印日志
MCP_BROWSER_TOKEN=