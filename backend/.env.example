# ===== 应用 =====
APP_NAME=multi-agent-xhs-platform
DEBUG=true
ENVIRONMENT=dev

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xhs_agent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== LLM: DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_V3=deepseek-chat
DEEPSEEK_MODEL_R1=deepseek-reasoner

# ===== 阿里云百炼 (Qwen-VL + 通义万相) =====
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen-vl-max
WANX_MODEL=wanx-v1
JIMENG_API_KEY=

# ===== 小红书 MCP =====
XHS_MCP_PLUGIN_URL=
XHS_MCP_LOCAL_CMD=
XHS_MCP_MODE=plugin

# ===== 多平台内容源（ContentSource）=====
# 默认数据源平台：tavily / builtin / hackernews / reddit / xiaohongshu
# tavily = Tavily 全网搜索（Google/Bing 级覆盖面，推荐，需 TAVILY_API_KEY）
# builtin = 内置中文话题库（零网络依赖，覆盖穿搭/美妆/美食等小红书常见类目）
# hackernews = HackerNews（技术社区，英文内容）
# reddit = Reddit（需配置下方凭证）
DEFAULT_SOURCE_PLATFORM=tavily
# 是否启用小红书内容源（默认关闭，有风控风险）
XHS_SOURCE_ENABLED=false

# ===== Tavily API（全网搜索，专为 AI Agent 设计）=====
# 申请地址：https://app.tavily.com/（新用户有免费额度）
# 配置后 search 节点会用 Tavily 做全网搜索（覆盖面比 HackerNews/Reddit 更广）
TAVILY_API_KEY=

# ===== Reddit API（OAuth2 personal use script）=====
# 申请地址：https://www.reddit.com/prefs/apps（选 script 类型）
# 填写后 search 节点会同时搜 HackerNews + Reddit，综合返回
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# script app 模式需要 Reddit 账号密码（用于搜索，client_credentials 模式只能拿热门不能搜索）
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ===== 加密 =====
AES_SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ===== LangGraph / Recovery =====
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_CIRCUIT_FAILURE_THRESHOLD=5
RECOVERY_CIRCUIT_RECOVERY_TIMEOUT=60
STRUCTURAL_RECOVERY_TIMEOUT_SECONDS=1800

# ===== SSE =====
SSE_HEARTBEAT_SECONDS=15
SSE_EVENT_BUFFER_LIMIT=1000

# ===== LangSmith（LangChain 追踪 & 评估平台）=====
# 申请地址：https://smith.langchain.com/（注册后获取 API Key）
# 开启后所有 LangGraph 工作流运行会自动追踪到 LangSmith 控制台
# 可查看每个节点的输入/输出/耗时/Token 用量/错误堆栈
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# 项目名称（在 LangSmith 控制台中分组展示）
LANGCHAIN_PROJECT=multi-agent-xhs-platform
# LangSmith 服务地址（默认官方，自部署时修改）
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]